# your domain, e.g https://example.com
APP_URL=http://localhost:3000
PORT=3000

# minimum of 32 characters. Generate one with: openssl rand -hex 32
APP_SECRET=REPLACE_WITH_LONG_SECRET

JWT_TOKEN_EXPIRES_IN=30d

DATABASE_URL="postgresql://postgres:password@localhost:5432/docmost?schema=public"
REDIS_URL=redis://127.0.0.1:6379

# options: local | s3 | azure
STORAGE_DRIVER=local

# S3 driver config
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# Azure Blob Storage driver config
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=

# default: 50mb
FILE_UPLOAD_SIZE_LIMIT=

# options: smtp | postmark
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Docmost

# SMTP driver config
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Postmark driver config
POSTMARK_TOKEN=

# for custom drawio server
DRAWIO_URL=

# Gotenberg URL for server-side PDF export
GOTENBERG_URL=

DISABLE_TELEMETRY=false

# Allow other sites to embed Docmost in an iframe.
IFRAME_EMBED_ALLOWED=false

# Only used when IFRAME_EMBED_ALLOWED=true. When empty, any origin is allowed.
# Example: https://intranet.example.com,https://portal.example.com
IFRAME_ALLOWED_ORIGINS=

# Enable debug logging in production (default: false)
DEBUG_MODE=false

# Log database queries
DEBUG_DB=false

# Log http requests
LOG_HTTP=false
# Comma-separated proxy IP/CIDR allowlist. Add ingress or load-balancer
# networks explicitly when deploying multiple application replicas.
TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128

# MCP server and vector search (disabled by default)
MCP_ENABLED=false
MCP_PUBLIC_BASE_URL=
# minimum 32 characters; generate with: openssl rand -hex 32
MCP_TOKEN_HASH_SECRET=
MCP_TOKEN_HASH_SECRET_PREVIOUS=
MCP_MAX_BATCH_SIZE=20
MCP_MAX_QUERY_LENGTH=1000
MCP_MAX_WRITE_CONTENT_LENGTH=200000
MCP_READ_AUDIT_SAMPLE_RATE=0
MCP_RATE_LIMIT_WINDOW_SECONDS=60
# 0 disables MCP request rate limiting.
MCP_RATE_LIMIT_MAX_REQUESTS=0
# bearer token for GET /api/mcp/metrics; minimum 32 characters
MCP_METRICS_TOKEN=
# Optional dedicated Catalog v2 signing secret. When unset, APP_SECRET is used
# so replicas that share APP_SECRET also share one deterministic signing key.
MCP_CATALOG_SIGNING_SECRET=
MCP_CATALOG_SIGNING_KEY_ID=
# JSON object of previous key IDs to SPKI DER base64url public keys.
MCP_CATALOG_PREVIOUS_PUBLIC_KEYS=
# Distributed challenge replay window; default 86400 seconds.
MCP_CATALOG_CHALLENGE_TTL_SECONDS=86400
# Signed v3 resolution tickets are short-lived and consumed once through Redis.
MCP_CATALOG_TICKET_TTL_SECONDS=120
# Maximum wall-clock window from ticket issuance to a signed v3 proof.
MCP_CATALOG_MAX_RESOLUTION_WINDOW_MS=120000

VECTOR_SEARCH_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# This release and its PostgreSQL vector column support 1536 only.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_DELAY_MS=500
VECTOR_CHUNK_MAX_CHARS=4000
VECTOR_CHUNK_OVERLAP_CHARS=300
VECTOR_HYBRID_SEMANTIC_WEIGHT=0.65
VECTOR_HYBRID_KEYWORD_WEIGHT=0.25
VECTOR_HYBRID_RECENCY_WEIGHT=0.10
# Exact scan for scopes with at most this many active chunks for the current model.
VECTOR_EXACT_CHUNK_THRESHOLD=4000
VECTOR_ANN_CANDIDATE_MULTIPLIER=24
VECTOR_ANN_MAX_CANDIDATES=5000
SEARCH_MAX_QUERY_LENGTH=1000
VECTOR_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
VECTOR_SEARCH_RATE_LIMIT_MAX_REQUESTS=60
